test_swap_test_001 ← {    
    reg3←#.quapl.circuit.reg 3
    reg3[2;2]←⊂ #.quapl.gates.H +.× #.quapl.sng.q0
    reg3[3;2]←⊂ #.quapl.gates.H +.× #.quapl.sng.q0
    vs ← #.quapl.circuit.thread_reg reg3     
    result ← #.quapl.lib._SWAP_TEST_ vs
    result ← 0  #.quapl.measurement.measure result
    'Swap Test: ' ⊢ (⊃((⊃⊃ result[1])[2])) Assert (#.quapl.sng.q0) :
    ''
}